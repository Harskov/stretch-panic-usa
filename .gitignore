# your own copy of the game goes here and never into git
orig/*
!orig/.gitkeep
build/
tools/*
!tools/check.py
!tools/audit_public.py
!tools/lint_*.py
reference/
__pycache__/
*.pyc
# a source folder named like one above is a package or namespace of the original, and is tracked
!/src/**/build/
!/src/**/reference/
!/include/**/build/
!/include/**/reference/
*.iso
*.bin
*.cue
*.elf
*.o
/asm/
/assets/
/expected/
/nonmatchings/
!/tools/dps2build.py
!/tools/download_tool.py
build.ninja
.ninja_*
objdiff.json
ctx.c
permuter_settings.toml
