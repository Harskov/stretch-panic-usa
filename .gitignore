# Nothing copyrighted enters this repository. The disc image, the boot ELF,
# extracted binaries and generated assembly are produced from the user's own
# disc at configure time and are never committed.
disc/
*.iso
*.elf
SLPM_*
SLUS_*
SLES_*
SCPS_*
# the splat YAML in config/ is configuration, not disc content (K2 §1)
!config/*.yaml
asm/
build/
tools/*
!tools/manifest.json
!tools/objdiff_report.py
!tools/lint_c.py
wip/*/target.s
wip/**/*.o
wip/**/*.bin
# compiled objects and lifted .text bytes at any depth under wip/ (permuter/target.o,
# *.o.text.bin): publication cleanup 2026-09-16 found 131 tracked by the old wip/*/*.o line
# calibration (S2): the C attempts, the table and results.jsonl are kept; disassembly
# of the original and compiled objects are not
calibration/candidates.md
calibration/*/target.s
calibration/*/*.o
calibration/*/*.bin
calibration/*/*.err
# permuter lane (S6): the working files hold absolute per-machine paths and logs; only the
# candidate C (output-*.c) and NOTES are kept (remediation 5 commit audit, 2026-09-17)
wip/*/permuter/bin/
wip/*/permuter/compile.sh
wip/*/permuter/permute.json
wip/*/permuter/*.log
wip/*/permuter/settings.toml
# generated per machine by configure.py (absolute tool paths)
build.ninja
.ninja_*
Makefile
# python / editor scratch
__pycache__/
*.pyc
# written by verify_run.py after the run commit; stays on disk, not in git
runs/*/verify.json
# external match lane (MatchRunner): bench objects and binaries stay out; attempt-*.c, runner.json,
# runs/runner/ and state/runner-*.jsonl are committed (companion change §7.8)
bench/*/attempts/*.o
bench/*/*.bin
bench/*/*/*.o
state/runner.lock
# xrefs.py index and naming census: derived from the asm, hold decoded game strings;
# regenerated, never committed (remediation 12)
reference/xrefs-index.json
reference/naming-census.json
targets-state.json
# S5 ghidra-hints exports: lifted from the ELF (decompiler C, decoded game strings, the
# xref graph), like asm/ and reference/xrefs-index.json. Regenerated by re-running S5;
# MANIFEST.json is the committed record (remediation 12 precedent, run 2026-09-19-013)
reference/ghidra/*
!reference/ghidra/MANIFEST.json
