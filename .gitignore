# Nothing copyrighted enters this repository. The disc image, the boot ELF,
# extracted binaries and generated assembly are produced from the user's own
# disc at configure time and are never committed.
disc/
*.iso
*.elf
SLPM_*
SLUS_*
SLES_*
SCPS_*
# the splat YAML in config/ is configuration, not disc content (K2 §1)
!config/*.yaml
asm/
build/
tools/*
!tools/manifest.json
wip/*/target.s
wip/**/*.o
wip/**/*.bin
# compiled objects and lifted .text bytes at any depth under wip/ (permuter/target.o,
# *.o.text.bin): publication cleanup 2026-09-16 found 131 tracked by the old wip/*/*.o line
# calibration (S2): the C attempts, the table and results.jsonl are kept; disassembly
# of the original and compiled objects are not
calibration/candidates.md
calibration/*/target.s
calibration/*/*.o
calibration/*/*.bin
calibration/*/*.err
# generated per machine by configure.py (absolute tool paths)
build.ninja
.ninja_*
Makefile
# python / editor scratch
__pycache__/
*.pyc
# written by verify_run.py after the run commit; stays on disk, not in git
runs/*/verify.json
# external match lane (MatchRunner): bench objects and binaries stay out; attempt-*.c, runner.json,
# runs/runner/ and state/runner-*.jsonl are committed (companion change §7.8)
bench/*/attempts/*.o
bench/*/*.bin
bench/*/*/*.o
state/runner.lock
# xrefs.py index: derived from the asm in 3 s, holds decoded game strings; regenerated, never committed
reference/xrefs-index.json
targets-state.json
